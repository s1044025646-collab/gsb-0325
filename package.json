{
  "name": "batcher-network-backend",
  "version": "1.0.0",
  "description": "Batcher 比较交换网络生成与零一原理核验后端（API + CLI）",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/*.test.js\"",
    "start": "node --experimental-sqlite dist/server.js",
    "cli": "node --experimental-sqlite dist/cli.js",
    "demo": "npm run build && node --experimental-sqlite dist/demo.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.10.0"
  }
}
